# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=20

# --- Frontend origins (CORS & CSRF) ---
ALLOWED_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# --- Database ---
DATABASE_URL=
TEST_DATABASE_URL=postgresql://postgres:8090@localhost:5432/study_test

# --- Login sessions ---
SESSION_LIFETIME_HOURS=168
COOKIE_NAME=session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Secret key (REQUIRED) ---
# Protects the emailed 6-digit codes. Make your own, keep it private:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

# --- Email (Brevo) ---
# Your Brevo API key (xkeysib-...) and verified sender email
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# --- One-time code rules (defaults shown) ---
# OTP_TTL_MINUTES=10
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_COOLDOWN_SECONDS=60
# OTP_MAX_SENDS_PER_HOUR=5
