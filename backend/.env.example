# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=20

# --- Frontend origins (used for CORS *and* the CSRF origin check) ---
ALLOWED_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
DATABASE_URL=

# Only for running tests. The database name MUST end in _test (tests wipe its tables).
TEST_DATABASE_URL=postgresql://postgres:[YOUR_PASSWORD]@localhost:5432/[DATABASE_NAME]

# --- Login sessions ---
SESSION_LIFETIME_HOURS=168
COOKIE_NAME=session

# Local development over http:  COOKIE_SECURE=false, COOKIE_SAMESITE=lax
# Production over https:        COOKIE_SECURE=true
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Secret key (REQUIRED) ---
# Protects the emailed 6-digit codes. Make your own, keep it private, never commit it:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Changing it later invalidates any codes that are currently waiting to be used.
SECRET_KEY=

# --- Email (verification codes + password reset) ---
# console = DEVELOPMENT ONLY: nothing is emailed, the code is printed in the backend terminal.
# smtp    = really send email using the SMTP_* settings below (required in production).
EMAIL_BACKEND=console

# Gmail example (needs 2-Step Verification on, then an "App password":
# https://myaccount.google.com/apppasswords ). Use the 16-character app password,
# NOT your normal Gmail password. Spaces in it are ignored.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=yourname@gmail.com
# SMTP_PASSWORD=abcdefghijklmnop
# SMTP_FROM=yourname@gmail.com

# --- One-time code rules (defaults shown) ---
# OTP_TTL_MINUTES=10
# OTP_MAX_ATTEMPTS=5
# OTP_RESEND_COOLDOWN_SECONDS=60
# OTP_MAX_SENDS_PER_HOUR=5